{
  "expo": {
    "name": "Notify",
    "slug": "notify",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "notificationfrontend",

    "userInterfaceStyle": "automatic",

    "newArchEnabled": false,

    "android": {
      "package": "com.deekshith.notify",
      "googleServicesFile": "./google-services.json",

      "notification": {
        "icon": "./assets/images/notification.png",
        "color": "#FF6B35"
      },

      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/notification.png",
        "backgroundImage": "./assets/images/notification.png",
        "monochromeImage": "./assets/images/notification.png"
      }
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],

      "expo-web-browser",

      "@react-native-google-signin/google-signin",

      "@react-native-firebase/app",

      "@react-native-firebase/messaging"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "eas": {
        "projectId": "d93cabfa-edc7-4c2a-aa03-9bc1dfbf4c97"
      }
    }
  }
}